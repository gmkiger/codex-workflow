#!/usr/bin/env bash
# Tracked pre-commit hook for the Codex academic workflow.
#
# Install once per clone:
#   ./scripts/install-hooks.sh

set -uo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
QUALITY_SCRIPT="$PROJECT_ROOT/scripts/quality_score.py"
THRESHOLD=80

RED="\033[0;31m"
YELLOW="\033[0;33m"
GREEN="\033[0;32m"
CYAN="\033[0;36m"
NC="\033[0m"

if [[ ! -f "$QUALITY_SCRIPT" ]]; then
    echo -e "${YELLOW}[pre-commit] quality_score.py not found — skipping quality gate${NC}" >&2
    exit 0
fi

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(tex|qmd|R)$' || true)"
if [[ -z "$STAGED_FILES" ]]; then
    exit 0
fi

echo -e "${CYAN}[pre-commit] Running quality gate on staged academic files...${NC}"

FAILED=0
WARNED=0
RESULTS=""

while IFS= read -r file; do
    if [[ ! -f "$PROJECT_ROOT/$file" ]]; then
        continue
    fi

    SCORE_OUTPUT="$(python3 "$QUALITY_SCRIPT" "$PROJECT_ROOT/$file" 2>/dev/null || true)"
    SCORE="$(echo "$SCORE_OUTPUT" | grep -oE 'Overall Score: [0-9]+|Score:[[:space:]]*[0-9]+' | grep -oE '[0-9]+' | head -1 || true)"

    if [[ -z "$SCORE" ]]; then
        RESULTS+="  ${YELLOW}?${NC}   $file (could not score)\n"
        continue
    fi

    if [[ "$SCORE" -lt "$THRESHOLD" ]]; then
        RESULTS+="  ${RED}FAIL${NC} $file — score: $SCORE / 100 (minimum: $THRESHOLD)\n"
        FAILED=$((FAILED + 1))
    elif [[ "$SCORE" -lt 90 ]]; then
        RESULTS+="  ${YELLOW}WARN${NC} $file — score: $SCORE / 100 (< 90: not PR-ready)\n"
        WARNED=$((WARNED + 1))
    else
        RESULTS+="  ${GREEN}PASS${NC} $file — score: $SCORE / 100\n"
    fi
done <<< "$STAGED_FILES"

echo -e "$RESULTS"

if [[ "$FAILED" -gt 0 ]]; then
    echo -e "${RED}[pre-commit] BLOCKED: $FAILED file(s) scored below $THRESHOLD.${NC}"
    echo -e "Fix the issues above, or override with: ${YELLOW}git commit --no-verify -m 'override: [reason]'${NC}"
    exit 1
fi

if [[ "$WARNED" -gt 0 ]]; then
    echo -e "${YELLOW}[pre-commit] WARNING: $WARNED file(s) scored below 90 (PR threshold). Commit allowed.${NC}"
fi

exit 0
